# SQLite file. Locally: file:./dev.db (relative to prisma/). On Railway: a path on the volume.
DATABASE_URL="file:./dev.db"

# Password for the dashboard. Leave unset locally to skip sign-in; REQUIRED in production.
ADMIN_PASSWORD=""

# Optional: extra secret mixed into session signing. Changing it signs everyone out.
AUTH_SECRET=""

# Optional: public base URL for short links, QR codes and the /s.js snippet,
# when it differs from the address the dashboard is opened on.
NEXT_PUBLIC_SHORT_BASE_URL=""
